  "components": {
    "securitySchemes": {
      "deviceSession": {
        "type": "http",
        "scheme": "bearer"
      },
      "bootstrapToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "recoverySession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Five-minute restricted recovery principal, never normal membership. Restored-household fence denies issuance."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "inputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "existingEnvelopeId": {
            "type": "string",
            "format": "uuid"
          },
          "existingReceipt": {
            "$ref": "#/components/schemas/Receipt"
          }
        },
        "required": [
          "code"
        ]
      },
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "header": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 262,
            "maxLength": 262
          },
          "ciphertext": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 38,
            "maxLength": 87035
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 86,
            "maxLength": 86
          }
        },
        "required": [
          "header",
          "ciphertext",
          "signature"
        ]
