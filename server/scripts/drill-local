#!/usr/bin/env python3
"""Disposable PostgreSQL base/WAL restore rehearsal. No cluster, DNS or credentials in output."""
import json, os, pathlib, secrets, shutil, subprocess, tempfile, time
os.umask(0o077)
if not __debug__:
    raise SystemExit('Local restore checks require Python validation enabled; remove -O/PYTHONOPTIMIZE')
root = pathlib.Path(__file__).resolve().parents[2]
image = 'postgres:16.15-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea'
directory = pathlib.Path(tempfile.mkdtemp(prefix='usuals-restore-drill-'))
names = ['usuals-restore-source-' + str(os.getpid()), 'usuals-restore-target-' + str(os.getpid())]
volumes = [name + '-data' for name in names] + [names[0] + '-backup']
def run(args, **kwargs):
    return subprocess.check_output(args, stderr=subprocess.PIPE, **kwargs).decode().strip()
def sql(name, statement):
    return run(['docker','exec','-i',name,'psql','-qAt','-U','postgres','-d','postgres','-v','ON_ERROR_STOP=1'], input=statement.encode())
def wait(name):
    for _ in range(90):
        if subprocess.run(['docker','exec',name,'pg_isready','-h','127.0.0.1','-U','postgres'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0: return
        time.sleep(.5)
    raise RuntimeError('Local restore database not ready')
try:
    run(['docker','pull','--platform','linux/amd64',image])
    metadata = json.loads(run(['docker','image','inspect','--platform','linux/amd64',image]))[0]
    assert metadata['Architecture'] == 'amd64' and metadata['Os'] == 'linux'
    assert metadata['Descriptor']['mediaType'] in ('application/vnd.oci.image.manifest.v1+json', 'application/vnd.docker.distribution.manifest.v2+json'), 'Expected a platform manifest, not an index'
    image = 'postgres@' + metadata['Descriptor']['digest']
    run(['docker','pull','--platform','linux/amd64',image])
    env = directory/'postgres.env'; env.write_text('POSTGRES_PASSWORD='+secrets.token_hex(32)+'\n')
    for volume in volumes: run(['docker','volume','create',volume])
    run(['docker','run','--platform','linux/amd64','--rm','-v',volumes[2]+':/backup',image,'sh','-ec','mkdir -p /backup/wal /backup/base; chown -R postgres:postgres /backup; chmod 700 /backup /backup/wal /backup/base'])
    run(['docker','run','--platform','linux/amd64','--rm','-d','--name',names[0],'--env-file',str(env),'-v',volumes[0]+':/var/lib/postgresql/data','-v',volumes[2]+':/backup','-v',str(root/'deploy/k8s/tools')+':/opt/usuals:ro',image,
        'postgres','-c','wal_level=replica','-c','archive_mode=on','-c','archive_timeout=60s','-c','archive_command=timeout 30s /opt/usuals/archive-wal "%p" "%f"'])
    wait(names[0])
    assert run(['docker','exec',names[0],'uname','-m']) == 'x86_64'
    sql(names[0], 'CREATE TABLE drill_marker (id integer PRIMARY KEY, value text); INSERT INTO drill_marker VALUES (1,\'before base\');')
    run(['docker','exec','--user','postgres',names[0],'/opt/usuals/base-backup'])
    base = run(['docker','exec',names[0],'sh','-ec','find /backup/base -mindepth 1 -maxdepth 1 -type d ! -name ".*"']).splitlines()
    assert len(base) == 1
    written = time.monotonic()
    segment = sql(names[0], "INSERT INTO drill_marker VALUES (2,'after base via WAL'); SELECT pg_walfile_name(pg_current_wal_lsn());").splitlines()[-1]
    sql(names[0], 'SELECT pg_switch_wal();')
    for _ in range(90):
        if subprocess.run(['docker','exec',names[0],'test','-f','/backup/wal/'+segment+'.gz'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0: break
        time.sleep(.5)
    else: raise RuntimeError('WAL archiving did not complete')
    archive_seconds = time.monotonic() - written
    # Exact retries succeed; a different source may not replace a valid archived segment.
    run(['docker','exec',names[0],'sh','-ec','printf one >/tmp/wal-test; /opt/usuals/archive-wal /tmp/wal-test TEST; /opt/usuals/archive-wal /tmp/wal-test TEST'])
    different = subprocess.run(['docker','exec',names[0],'sh','-ec','printf two >/tmp/wal-test; /opt/usuals/archive-wal /tmp/wal-test TEST'], capture_output=True)
    assert different.returncode != 0
    run(['docker','exec',names[0],'rm','/backup/wal/TEST.gz'])
    started = time.monotonic()
    run(['docker','run','--platform','linux/amd64','--rm','-v',volumes[1]+':/restore','-v',volumes[2]+':/backup:ro',image,'sh','-ec',
        'cp -a '+base[0]+'/. /restore/; rm -f /restore/postmaster.pid /restore/standby.signal; touch /restore/recovery.signal; chown -R postgres:postgres /restore; chmod 700 /restore'])
    run(['docker','run','--platform','linux/amd64','--rm','-d','--name',names[1],'--env-file',str(env),'-v',volumes[1]+':/var/lib/postgresql/data','-v',volumes[2]+':/backup:ro',image,
        'postgres','-c','archive_mode=off','-c','restore_command=gzip -dc /backup/wal/%f.gz > %p'])
    wait(names[1])
    assert run(['docker','exec',names[1],'uname','-m']) == 'x86_64'
    assert sql(names[1], 'SELECT count(*) FROM drill_marker;') == '2'
    rto = time.monotonic() - started
    print(json.dumps({'passed':True,'postgresPlatform':'linux/amd64','postgresImageId':metadata['Id'],'baseVerified':True,'postBaseWalCommitRecovered':True,'conflictingArchiveRejected':True,
        'localArchiveSeconds':round(archive_seconds,3),'localRestoreSeconds':round(rto,3),
        'offClusterRpoVerified':False,'clusterRestoreVerified':False}))
except Exception as error:
    # Docker stderr can contain environment values, SQL or file paths. Keep diagnostics private.
    (directory/'failure.txt').write_text(type(error).__name__+'\n'+str(error)+'\n'+getattr(error,'stderr',b'').decode(errors='replace'))
    print('FAIL: inspect protected evidence '+str(directory/'failure.txt'))
    raise SystemExit(1)
finally:
    for name in names: subprocess.run(['docker','rm','-f',name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for volume in volumes: subprocess.run(['docker','volume','rm',volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (directory/'postgres.env').unlink(missing_ok=True)
    if not (directory/'failure.txt').exists(): shutil.rmtree(directory)
