{
  "formatVersion": 1,
  "cases": [
    {
      "id": "replayed-challenge",
      "given": "used nonce",
      "expected": "unauthenticated"
    },
    {
      "id": "wrong-purpose-proof",
      "given": "session signature used for recovery",
      "expected": "unauthenticated"
    },
    {
      "id": "cross-household-envelope",
      "given": "URL/header/list mismatch",
      "expected": "not_found"
    },
    {
      "id": "substituted-join-key",
      "given": "directory key differs from verified fingerprint",
      "expected": "reject_local"
    },
    {
      "id": "invite-expired",
      "given": "approval after 10 minutes",
      "expected": "invalid"
    },
    {
      "id": "invite-consumed-twice",
      "given": "two approvals for one invite",
      "expected": "membership_conflict"
    },
    {
      "id": "removed-device-session",
      "given": "valid old session after removal",
      "expected": "forbidden"
    },
    {
      "id": "stale-epoch-append",
      "given": "old key after membership CAS",
      "expected": "epoch_stale"
    },
    {
      "id": "lost-ack-across-rotation",
      "given": "stable intent id, new envelope id",
      "expected": "intent_exists"
    },
    {
      "id": "envelope-id-different-bytes",
      "given": "same envelope id, changed ciphertext",
      "expected": "envelope_conflict"
    },
    {
      "id": "incomplete-key-packages",
      "given": "new epoch missing retained recipient",
      "expected": "invalid"
    },
    {
      "id": "snapshot-raced-append",
      "given": "list head changed before membership CAS",
      "expected": "membership_conflict"
    },
    {
      "id": "unauthorized-owner-claim",
      "given": "editor signs a manifest claiming ownership",
      "expected": "forbidden"
    },
    {
      "id": "unaccepted-owner-transfer",
      "given": "no recipient acceptance signature",
      "expected": "invalid"
    },
    {
      "id": "old-recovery-kit",
      "given": "recovery principal revoked by later manifest",
      "expected": "forbidden"
    },
    {
      "id": "restored-spent-invite",
      "given": "database restore reinstates old row",
      "expected": "recovery_required"
    },
    {
      "id": "server-head-rollback",
      "given": "server lower than pinned client head",
      "expected": "recovery_required"
    },
    {
      "id": "unsupported-version",
      "given": "future payload or normalizer version",
      "expected": "upgrade_required"
    },
    {
      "id": "body-too-large",
      "given": "over encoded request ceiling",
      "expected": "too_large"
    },
    {
      "id": "unauthorized-snapshot",
      "given": "removed device requests current snapshot",
      "expected": "forbidden"
    },
    {
      "id": "roster-only-rollback",
      "given": "epoch 2 removed a device without any list edit, restore epoch 1",
      "expected": "recovery_required"
    },
    {
      "id": "revoked-fresh-challenge-after-restore",
      "given": "restored roster contains removed device, new session challenge",
      "expected": "recovery_required"
    },
    {
      "id": "recovery-ordinary-append",
      "given": "restricted recovery session attempts shopping edit",
      "expected": "forbidden"
    },
    {
      "id": "recovery-arbitrary-owner-change",
      "given": "recovery transition retains an old normal device",
      "expected": "forbidden"
    },
    {
      "id": "join-recipient-substitution",
      "given": "signed assertion recipient key changed in pending response",
      "expected": "reject_local"
    },
    {
      "id": "mixed-append-conflict",
      "given": "new envelope plus conflicting intent in one batch",
      "expected": "rollback_all_new"
    },
    {
      "id": "mixed-append-retry",
      "given": "new envelope plus identical accepted retry",
      "expected": "one_new_sequence"
    },
    {
      "id": "bootstrap-empty-roster",
      "given": "genesis has no lists; candidate staged by household owner before CreateList",
      "expected": "accepted"
    }
  ]
}
