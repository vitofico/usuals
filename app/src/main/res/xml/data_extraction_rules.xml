<?xml version="1.0" encoding="utf-8"?>
<!-- Only the database may transfer directly to a new device. Secrets never transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- An explicit include list excludes every other domain, including secrets. -->
        <include domain="database" path="usuals.db" />
        <include domain="database" path="usuals.db-wal" />
        <include domain="database" path="usuals.db-shm" />
    </device-transfer>
</data-extraction-rules>
