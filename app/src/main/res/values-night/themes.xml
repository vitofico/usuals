<?xml version="1.0" encoding="utf-8"?>
<!-- The window shell matches the dark Compose palette. -->
<resources>
    <style name="Theme.Comanda" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/comanda_ground_dark</item>
        <item name="android:statusBarColor">@color/comanda_ground_dark</item>
        <item name="android:navigationBarColor">@color/comanda_ground_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/comanda_accent</item>
    </style>
</resources>
