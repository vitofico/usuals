#!/usr/bin/env bash
#
# Credential detection over this repository's whole git history.
#
# The same command CI runs, so a contributor can answer "would this fail the
# scan" before pushing rather than after. Like scripts/dgradle, it runs in a
# container pinned by digest, so the scanner here and the scanner there are the
# same bytes and a version bump is a visible edit to this file.
#
#   scripts/secret-scan            scan the whole history
#   scripts/secret-scan --staged   scan what is about to be committed
#
# A finding prints the rule, the file and the line and exits non-zero. If it is
# genuinely not a secret, add its exact value to .gitleaks.toml, never its path,
# and read the comment at the top of that file for why.
set -euo pipefail

# gitleaks v8.30.1. Pinned by digest rather than by tag for the reason every
# action in .github/workflows is pinned by SHA: a tag is a name somebody else
# can repoint.
IMAGE="zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# `protect --staged` reads the index instead of the history, which is the only
# useful thing to scan before a commit exists.
if [ "${1:-}" = "--staged" ]; then
  set -- protect --staged
else
  set -- detect
fi

exec docker run --rm \
  -v "$REPO_ROOT:/repo" \
  -w /repo \
  "$IMAGE" \
  "$@" \
  --source=/repo \
  --config=/repo/.gitleaks.toml \
  --redact \
  --verbose \
  --no-banner
