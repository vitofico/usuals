#!/usr/bin/env bash
# The same checks run locally before submission and in GitHub Actions.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

android() {
  scripts/retry-gradle-download scripts/dgradle verifyReleaseTools \
    :app:assembleDebug :app:assembleRelease test lint \
    --no-daemon --no-watch-fs --no-parallel --max-workers=2
  python3 scripts/check-native-alignment.py app/build/outputs/apk/release/app-release-unsigned.apk
}

server() {
  scripts/retry-gradle-download server/scripts/test-local --no-daemon --no-parallel --max-workers=2
}

case "${1:-all}" in
  android) android ;;
  server) server ;;
  secrets) scripts/secret-scan ;;
  all) scripts/secret-scan; android; server ;;
  --help|-h)
    echo 'Usage: scripts/check-ci [all|android|server|secrets]'
    echo 'Requires Docker. Default: history secret scan, Android build/test/lint/alignment, PostgreSQL and browser protocol tests.'
    echo 'Native emulator and CodeQL checks are separate.'
    ;;
  *) echo 'Usage: scripts/check-ci [all|android|server|secrets]' >&2; exit 2 ;;
esac
